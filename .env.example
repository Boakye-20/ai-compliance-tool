# ──────────────────────────────────────────────────────────────
# AI Compliance Tool — Environment Variables
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── LLM Key (required for analysis pipeline) ─────────────────
# OpenAI — GPT-4o for extraction, GPT-4o-mini for framework analysis
OPENAI_API_KEY=

# ── Compliance API (for CLI / CI/CD submissions) ─────────────
# Generate this in your app's Integrations tab
COMPLIANCE_API_KEY=
COMPLIANCE_API_URL=https://ai-compliance-tool-cyan.vercel.app

# ── Database (optional — app works in-memory without it) ─────
# Neon / Vercel Postgres connection string
POSTGRES_URL=

# ── Policy Tracker Feed (optional) ───────────────────────────
# Defaults to https://www.aipolicytracker.uk/updates.json
# POLICY_TRACKER_FEED_URL=

# ── Admin Authentication (required for API key management) ───
# Secret shared between the deployment and admin tooling.
# The /api/keys route rejects all requests when this is unset.
ADMIN_SECRET=

# ── Legacy (no longer needed after LLM swap) ─────────────────
# PPLX_API_KEY=
